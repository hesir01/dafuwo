# 复制为 .env 后按实际环境修改（服务器上的 .env 不要进 Git）
PORT=3000
NODE_ENV=production

# 前端访问地址：必须与浏览器地址栏的「协议 + 域名」完全一致
# 支持逗号分隔的多个来源（IP 与域名同时可访问）：
#   生产：CLIENT_URL=http://43.128.149.78:8010,https://boluodafuwo.duckdns.org
#   本地开发：http://localhost:5173
# ⚠️ 不改这一项，Socket.IO 会被 CORS 拒绝（表现：大厅一直显示未连接、建房无反应）
CLIENT_URL=http://localhost:5173
