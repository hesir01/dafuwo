{
  "name": "op-monopoly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "航海王大富翁 - 网页联机大富翁（Phaser 3 + Socket.IO）",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "build:deploy": "vite build && python3 tools/trim_dist.py",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node tests/engine.test.js && node tests/mechanics.test.js && node tests/trade_consent.test.js && node tests/rooms.test.js",
    "test:ui": "node tools/verify_panel_layout.cjs",
    "balance": "node tools/balance_sim.mjs 3000"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.8.1",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
